# =============================================================================
# Stock Market Analysis System - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=stock_analysis

# -----------------------------------------------------------------------------
# Alpha Vantage API Configuration
# Get your free API key from: https://www.alphavantage.co/support/#api-key
# Free Tier Limits: 5 requests/minute, 500 requests/day
# -----------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=your_api_key_here
API_PROVIDER=alpha_vantage

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
MAX_REQUESTS_PER_MINUTE=5
MAX_REQUESTS_PER_DAY=500

# -----------------------------------------------------------------------------
# Cron Job Configuration
# Schedule format: "minute hour day month weekday"
# Default: "0,30 * * * *" (twice per hour at XX:00 and XX:30)
# -----------------------------------------------------------------------------
ENABLE_CRON_JOBS=true
CRON_SCHEDULE=0,30 * * * *
MAX_STOCKS_PER_RUN=10

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_REALTIME=false
ENABLE_ADVANCED_METRICS=true
ENABLE_ALERTS=false

# -----------------------------------------------------------------------------
# Alert Configuration (Optional - requires ENABLE_ALERTS=true)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_FROM_EMAIL=alerts@stockanalysis.com
ALERT_TO_EMAIL=admin@stockanalysis.com

# -----------------------------------------------------------------------------
# Webhook Configuration (Optional)
# -----------------------------------------------------------------------------
WEBHOOK_URL=https://your-webhook-endpoint.com/events
WEBHOOK_SECRET=your_webhook_secret

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Risk Disclaimer
# =============================================================================
# This system provides automated investment recommendations based on technical
# analysis. Past performance is not indicative of future results. Investment
# decisions involve risk and may result in financial loss. Users should conduct
# their own research and consult with financial advisors before making any
# investment decisions.
# =============================================================================
FRED_API_KEY=            # optional — enables FRED India CPI/GDP macro (monthly cron); absent ⇒ skipped honestly

# -----------------------------------------------------------------------------
# Angel One SmartAPI — REAL-TIME NSE market data (docs/intraday-study-notes.md)
#
# Free with an Angel One demat account. Provides a genuine real-time tick
# stream, which is what lifts the engine's data mode to STREAMING (authority
# ceiling BUY_CANDIDATE). Without these the system falls back to DELAYED
# candles / EOD bars and honestly caps every action at WAIT — it never
# pretends a delayed price is live.
#
# Where to get them: https://smartapi.angelbroking.com/ → create an app.
#   ANGELONE_API_KEY     the app's API key
#   ANGELONE_CLIENT_CODE your Angel One login/client id (e.g. A123456)
#   ANGELONE_PIN         your login PIN (NOT your trading password)
#   ANGELONE_TOTP_SECRET the BASE32 secret shown when you enable TOTP 2FA.
#                        This is the SEED, not a 6-digit code — the server
#                        derives a fresh code per login. Treat as a password.
#
# SEBI: from 1 Apr 2026 API-based TRADING requires a static IP registered with
# the broker. This system only READS market data and places no orders, but if
# you later enable order placement you must register the host's static IP.
#
# NEVER commit real values. .env is gitignored; this file is the template.
# -----------------------------------------------------------------------------
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
